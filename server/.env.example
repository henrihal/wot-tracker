# Copy to .env and fill in. See CLAUDE.md "Environment" for detail.

# ---- Database (required) ----
# Pick ONE mode.
#
# Mode A — local Postgres container (e.g. Apple Containers / docker compose):
#   DATABASE_URL="postgresql://wot:wot@db:5432/wot?schema=public"
#
# Mode B — external managed Postgres (behind PgBouncer, so use a direct URL
#   for migrations via DIRECT_DATABASE_URL):
#   DATABASE_URL="postgresql://USER:PASS@HOST:5432/DB?sslmode=require&pgbouncer=true&connection_limit=1"
#   DIRECT_DATABASE_URL="postgresql://USER:PASS@HOST:5432/DB?sslmode=require"
#
# If you omit DIRECT_DATABASE_URL, the Prisma CLI (migrate deploy / generate)
# falls back to DATABASE_URL — fine for Mode A and for Mode B without PgBouncer.
DATABASE_URL=""
# DIRECT_DATABASE_URL=""

# ---- Wargaming (required) ----
WARGAMING_APPLICATION_ID=""
WARGAMING_REALM="eu"

# ---- Server (optional) ----
# PORT=3001

# ---- Wargaming cache TTLs in seconds (optional; default 3600) ----
# WARGAMING_CACHE_TTL_SECONDS=3600
# WARGAMING_INFO_CACHE_TTL_SECONDS=3600
# WARGAMING_VEHICLES_CACHE_TTL_SECONDS=3600

# ---- Daily snapshot capture job (optional; off by default) ----
# SNAPSHOT_JOB_ENABLED=true

# ---- Admin endpoints /admin/* (optional; fail-closed) ----
# Shared secret checked against the X-Admin-Token request header. If unset,
# every /admin route returns 503 (admin disabled).
# ADMIN_TOKEN=