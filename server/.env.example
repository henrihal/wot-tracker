# Copy to .env and fill in. See CLAUDE.md "Environment" for detail.

# --- Required ---
DATABASE_URL="file:./dev.db"
WARGAMING_APPLICATION_ID=""
WARGAMING_REALM="eu"

# --- Optional: Wargaming cache TTLs (seconds; default 3600) ---
# WARGAMING_CACHE_TTL_SECONDS=3600
# WARGAMING_INFO_CACHE_TTL_SECONDS=3600
# WARGAMING_VEHICLES_CACHE_TTL_SECONDS=3600

# --- Optional: server ---
# PORT=3001

# --- Optional: daily snapshot capture job (off by default) ---
# SNAPSHOT_JOB_ENABLED=true

# --- Optional: admin endpoints (/admin/*) ---
# Shared secret checked against the X-Admin-Token request header. If unset,
# every /admin route returns 503 (admin disabled) — fail-closed.
# ADMIN_TOKEN=