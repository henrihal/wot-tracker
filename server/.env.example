# Copy to .env and fill in. Full detail in the root README "Configuration".

# ---- Required ----
DATABASE_URL=""
WARGAMING_APPLICATION_ID=""

# ---- Optional ----
WARGAMING_REALM="eu" # eu | na | asia | ru
# PORT=3001
# DIRECT_DATABASE_URL= # non-pooled URL for migrations when DATABASE_URL is pooled (PgBouncer)
# Wargaming cache TTLs in seconds (default 3600):
# WARGAMING_CACHE_TTL_SECONDS=
# WARGAMING_INFO_CACHE_TTL_SECONDS=
# WARGAMING_VEHICLES_CACHE_TTL_SECONDS=
# SNAPSHOT_JOB_ENABLED=true # enables the daily snapshot capture job
# ADMIN_TOKEN= # shared secret for /admin/*; unset disables admin (503)
