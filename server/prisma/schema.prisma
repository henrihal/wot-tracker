// This is your Prisma schema file,
// learn more at it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model PlayerSearchCache {
  search     String
  realm      String
  response   String
  fetchedAt  DateTime @default(now())
  expiresAt  DateTime

  @@id([search, realm])
  @@index([expiresAt])
}

model PlayerInfoCache {
  accountId Int
  realm     String
  response  String
  fetchedAt DateTime @default(now())
  expiresAt  DateTime

  @@id([accountId, realm])
  @@index([expiresAt])
}

model PlayerStatsSnapshot {
  id             Int      @id @default(autoincrement())
  accountId      Int
  realm          String
  capturedAt     DateTime @default(now())
  lastBattleTime Int?
  data           String // JSON of { all, random } core counters

  @@unique([accountId, realm, capturedAt])
  @@index([accountId, realm, capturedAt])
}

model TrackedAccount {
  accountId Int
  realm     String
  addedAt   DateTime @default(now())

  @@id([accountId, realm])
}

model Vehicle {
  tankId    Int      @id
  name      String
  shortName String
  nation    String
  tier      Int
  type      String
  isPremium Boolean
  tag       String?
  fetchedAt DateTime @default(now())
}

model VehicleExpectedValue {
  tankId     Int      @id
  expFrag    Float
  expDamage  Float
  expSpot    Float
  expDef     Float
  expWinRate Float
  version    String
  fetchedAt  DateTime @default(now())
}

model PlayerVehicleStatsCache {
  accountId Int
  realm     String
  response  String
  fetchedAt DateTime @default(now())
  expiresAt DateTime

  @@id([accountId, realm])
  @@index([expiresAt])
}

model PlayerVehicleSnapshot {
  id         Int      @id @default(autoincrement())
  accountId  Int
  realm      String
  capturedAt DateTime @default(now())
  data       String // JSON map of { [tankId]: WN8 input counters }

  @@unique([accountId, realm, capturedAt])
  @@index([accountId, realm, capturedAt])
}
